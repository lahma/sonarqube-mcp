<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sonarqube-mcp</AssemblyName>
    <RootNamespace>SonarQube.Mcp</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StripSymbols>true</StripSymbols>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Required for IDE0005 (unnecessary usings) to run under EnforceCodeStyleInBuild;
         CS1591 is silenced centrally. See https://github.com/dotnet/roslyn/issues/41640. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- D17: the NuGet convenience channel. `dotnet pack` produces a framework-dependent .NET tool
       package (`dnx mcp-sonarqube`); the Native AOT single binary published to GitHub Releases
       stays the recommended way to run the server. PackageType McpServer is what nuget.org filters
       on to show the MCP tab and generate client configuration; PackAsTool already makes it a tool
       package, so DotnetTool is deliberately NOT listed alongside it (the mcpserver template does
       the same).

       PackageId is mcp-sonarqube, not sonarqube-mcp, and it is the ONLY name that differs from the
       product: SonarSource holds BOTH the `SonarQube*` and the `SonarCloud*` reserved package-id
       prefixes on nuget.org, discovered by two rejected pushes of v1.0.0 on 2026-08-22 - first
       `sonarqube-mcp`, then `sonarcloud-mcp`, each answered Conflict. `mcp-*` is unreserved (many
       independent owners publish under it), so the id leads with it. ToolCommandName stays
       sonarqube-mcp deliberately - it is the command the package installs and the name every
       archive, binary and document uses, and the id a package is fetched by is not the name it
       runs under. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <PackageId>mcp-sonarqube</PackageId>
    <ToolCommandName>sonarqube-mcp</ToolCommandName>
    <!-- The tool half is framework-dependent, so it must keep working on a runtime newer than the
         one it was built against. -->
    <RollForward>Major</RollForward>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;mcp-server;model-context-protocol;sonarqube;sonarcloud;sonarqube-cloud;code-quality;static-analysis;ai;stdio</PackageTags>
    <Description>Model Context Protocol server for SonarQube Cloud - projects, quality gates, issues, security hotspots, measures and coverage, plus issue triage - with a deliberately small, auditable dependency tree. Native AOT binaries are published to GitHub Releases; this package is the `dnx mcp-sonarqube` convenience channel (the id differs from the product name because SonarSource holds both the SonarQube* and SonarCloud* reserved package-id prefixes on nuget.org; the installed command is still `sonarqube-mcp`).</Description>
  </PropertyGroup>

  <!-- PackTool.targets packs $(PublishDir), so `dotnet pack` runs a publish of this project. Left
       alone that publish would inherit PublishAot=true above and fail for want of a RuntimeIdentifier
       (D9 keeps RIDs out of the csproj). The AOT publish always passes -r, so keying the property off
       RuntimeIdentifier gives the release path AOT and the pack path a portable IL tool. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <!-- The three analyzers above are what turn an AOT-hostile line of code (IL2026, IL3050) into a
       build error under TreatWarningsAsErrors. The SDK derives them from PublishAot, so leaving
       them implicit would switch them off for every RID-less build - which is every `dotnet build`,
       every `dotnet test` and every IDE session. Stated explicitly, they no longer depend on it. -->
  <PropertyGroup>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed into the package root as /.mcp/server.json, which is where nuget.org looks for the
         MCP server manifest. Both files live at the repository root - one server manifest per
         repository, and the same README.md the AOT archives ship - so they are referenced from
         there rather than duplicated under src/. -->
    <None Include="../../.mcp/server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- Deliberately absent (D9/D10): RuntimeIdentifiers (would pull ILCompiler packs per RID on
       every restore - the RID reaches publish via -r), PublishSingleFile (ignored under AOT) and
       SelfContained (implied by PublishAot). -->

  <ItemGroup>
    <InternalsVisibleTo Include="SonarQube.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
