<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- The complete package budget. Adding anything here requires a recorded decision in AGENTS.md.
       Three app packages, not the template's four: authentication is a single static token read
       from the environment, so there is no token cache to protect and no ProtectedData row. -->
  <ItemGroup Label="App">
    <!-- Exact pin: the MCP SDK's AOT/serializer contract is verified against this version only. -->
    <PackageVersion Include="ModelContextProtocol" Version="[2.2.0]" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

  <!-- The tests run NUnit on Microsoft.Testing.Platform (NUnit3TestAdapter's runner), not VSTest. -->
  <ItemGroup Label="Test">
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

</Project>
